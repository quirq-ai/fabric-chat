# Made by `npm run net:up`: test certificates and private keys, genesis blocks, the compose file. Never commit these.
.generated/
node_modules/
dist/
*.log

# Made by `npm run bundle`, and where the app keeps accounts if it is ever run as one company outside Docker.
build/
.data/

# Single-file copies of the Markdown documents, made for sending to someone. GitHub shows the Markdown itself.
docs/*.html

# Companies started on this machine from node-template, each in a folder of its own. Their keys are in Docker volumes, not here.
companies/
